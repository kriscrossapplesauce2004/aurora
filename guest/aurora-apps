#!/usr/bin/env python3
"""One Arch application profile for cross-rootfs staging and guest migration."""
import argparse
import configparser
import fcntl
import json
import os
from pathlib import Path
import pwd
import shlex
import subprocess
import sys

VERSION = 2
BASE = (
    ('terminal', 'foot', 'foot', 'foot.desktop'),
    ('browser', 'firefox', 'firefox', 'firefox.desktop'),
    ('files', 'thunar', 'thunar', 'thunar.desktop'),
    ('editor', 'mousepad', 'mousepad', 'org.xfce.mousepad.desktop'),
    ('calculator', 'galculator', 'galculator', 'galculator.desktop'),
)
EXTRAS = (
    ('images', 'loupe', 'loupe', 'org.gnome.Loupe.desktop'),
    ('documents', 'papers', 'papers', 'org.gnome.Papers.desktop'),
    ('archives', 'file-roller', 'file-roller', 'org.gnome.FileRoller.desktop'),
)
SUPPORT = ('desktop-file-utils', 'xdg-utils', 'xdg-user-dirs', 'ttf-dejavu',
           'ttf-jetbrains-mono-nerd', 'ttf-material-symbols-variable', 'inotify-tools',
           'adwaita-icon-theme', 'shared-mime-info', 'fontconfig', 'gtk-update-icon-cache')
PROFILES = ('base', 'extended', 'none')


def selected(root):
    path = root / 'etc/aurora-apps-profile'
    profile = path.read_text().strip() if path.exists() else 'extended'
    if profile not in PROFILES:
        raise RuntimeError(f'{path}: expected base, extended, or none, got {profile!r}')
    return profile


def apps(profile):
    return () if profile == 'none' else BASE + (EXTRAS if profile == 'extended' else ())


def packages(profile):
    return [app[1] for app in apps(profile)] + (list(SUPPORT) if profile != 'none' else [])


def rooted(root, path):
    # Absolute target symlinks must resolve inside the offline root, not the PC.
    parts = list(Path(path).parts)
    current = root
    links = 0
    while parts:
        part = parts.pop(0)
        if part in ('/', '.'):
            continue
        if part == '..':
            if current == root:
                raise RuntimeError(f'path escapes root: {path}')
            current = current.parent
            continue
        current /= part
        if current.is_symlink():
            links += 1
            if links > 40:
                raise RuntimeError(f'symlink loop: {path}')
            target = os.readlink(current)
            current = root if target.startswith('/') else current.parent
            parts = list(Path(target).parts) + parts
    return current


def check(root, profile):
    for role, package, binary, desktop in apps(profile):
        executable = rooted(root, f'usr/bin/{binary}')
        if not executable.is_file() or not executable.stat().st_mode & 0o111:
            raise RuntimeError(f'{role}: {package} is missing executable /usr/bin/{binary}')
        entry = rooted(root, 'usr/share/applications/' + desktop)
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.read(entry)
        if not parser.has_section('Desktop Entry'):
            raise RuntimeError(f'{package}: missing desktop entry {desktop}')
        section = parser['Desktop Entry']
        command = shlex.split(section.get('Exec', ''))
        if (section.get('Type') != 'Application' or not command
                or section.get('Hidden', 'false').lower() == 'true'
                or section.get('NoDisplay', 'false').lower() == 'true'):
            raise RuntimeError(f'{desktop}: not a visible application entry')
        name = command[0]
        command_path = rooted(root, name if name.startswith('/') else 'usr/bin/' + name)
        if not command_path.is_file() or not command_path.stat().st_mode & 0o111:
            raise RuntimeError(f'{desktop}: Exec does not resolve to an executable: {name}')
        if not section.get('Icon'):
            raise RuntimeError(f'{desktop}: missing Icon')
    if profile != 'none':
        for directory in ('usr/share/fonts', 'usr/share/icons', 'usr/share/mime'):
            if not rooted(root, directory).is_dir():
                raise RuntimeError(f'missing integration directory: /{directory}')


def run(*command):
    subprocess.run(command, check=True)


# The Omarchy shell draws its bar glyphs from a Nerd Font and resolves the
# family through this fontconfig alias. Without both, every icon is blank.
MONOSPACE_FONT = 'JetBrainsMono Nerd Font'
FONTCONFIG_DROPIN = 'etc/fonts/conf.d/99-aurora-monospace.conf'


def ensure_monospace_alias(root):
    path = rooted(root, FONTCONFIG_DROPIN)
    if path.exists():
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        '<?xml version="1.0"?>\n'
        '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n'
        '<fontconfig>\n'
        '  <match target="pattern">\n'
        '    <test name="family" qual="any"><string>monospace</string></test>\n'
        '    <edit name="family" mode="prepend_first" binding="strong">\n'
        f'      <string>{MONOSPACE_FONT}</string>\n'
        '    </edit>\n'
        '  </match>\n'
        '</fontconfig>\n')


def apply(root=Path('/')):
    if subprocess.check_output(['aurora-platform', 'id'], text=True).strip() != 'arch':
        raise RuntimeError('application profiles currently support Arch Linux ARM only')
    profile = selected(root)
    state = root / 'var/lib/aurora'
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'apps.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if profile == 'none':
            print('Application profile disabled; existing applications left unchanged.')
            return
        ignored = subprocess.check_output(['pacman-conf', 'IgnorePkg'], text=True).split()
        held = {'systemd', 'systemd-libs', 'systemd-sysvcompat', 'systemd-resolvconf'}
        if not held.issubset(ignored):
            raise RuntimeError('pacman IgnorePkg must retain all four kernel-compatible systemd packages')
        desired = {'version': VERSION, 'profile': profile, 'packages': packages(profile)}
        marker = state / 'apps.json'
        try:
            previous = json.loads(marker.read_text())
        except (OSError, ValueError):
            previous = None
        installed = subprocess.run(['pacman', '-Q', *packages(profile)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if previous == desired and installed:
            check(root, profile)
            print(f'Applications already provisioned: {profile} v{VERSION}')
            return
        marker.unlink(missing_ok=True)
        run('aurora-platform', 'package-install', *packages(profile))
        run('pacman', '-Q', *packages(profile))
        check(root, profile)
        for _, _, _, desktop in apps(profile):
            run('desktop-file-validate', '/usr/share/applications/' + desktop)
        run('update-desktop-database', '/usr/share/applications')
        run('update-mime-database', '/usr/share/mime')
        run('glib-compile-schemas', '/usr/share/glib-2.0/schemas')
        ensure_monospace_alias(root)
        run('fc-cache', '-f')
        for icon in (root / 'usr/share/icons').iterdir():
            if (icon / 'index.theme').is_file():
                run('gtk-update-icon-cache', '-f', '-t', str(icon))
        user = pwd.getpwnam('aurora')
        if user.pw_uid != 1000:
            raise RuntimeError('aurora must have uid 1000 before application migration')
        run('runuser', '-u', 'aurora', '--', 'env', 'HOME=' + user.pw_dir,
            'xdg-user-dirs-update')
        config = Path(user.pw_dir) / '.config/user-dirs.dirs'
        if not config.is_file() or config.stat().st_uid != user.pw_uid:
            raise RuntimeError('user directories were not configured as aurora')
        temporary = marker.with_suffix('.tmp')
        temporary.write_text(json.dumps(desired, indent=2) + '\n')
        temporary.replace(marker)
        print(f'Applications provisioned: {profile} v{VERSION}; graphical qualification pending')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('packages', 'check', 'apply'))
    parser.add_argument('--root', type=Path, default=Path('/'))
    parser.add_argument('--profile', choices=PROFILES)
    args = parser.parse_args()
    root = args.root.resolve()
    profile = args.profile or selected(root)
    if args.command == 'packages':
        print('\n'.join(packages(profile)))
    elif args.command == 'check':
        check(root, profile)
    else:
        if args.profile:
            parser.error('set /etc/aurora-apps-profile to select a persistent migration profile')
        if root != Path('/') or os.geteuid() != 0:
            parser.error('apply must run as root inside the guest, not against an offline root')
        apply(root)


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError, ValueError) as exc:
        print(f'aurora-apps: {exc}', file=sys.stderr)
        sys.exit(1)
